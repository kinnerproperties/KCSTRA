{
  "buildCommand": "node scripts/build-blog.js",
  "outputDirectory": ".",
  "rewrites": [],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/data/audit/:path*",
      "destination": "/audit",
      "permanent": false
    }
  ],
  "crons": [
    {
      "path": "/api/cron-rebuild",
      "schedule": "0 12 * * *"
    }
  ]
}
